<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prayer Times - Islamic Habits | Accurate Salah Times & Qibla Direction</title>
    <meta name="description" content="Get accurate prayer times based on your location with multiple calculation methods. Never miss a prayer with Islamic Habits prayer time feature.">
    
    <style>
        :root {
            --primary-color: #1a5e63;
            --primary-dark: #0f4a4d;
            --primary-light: #2d936c;
            --secondary-color: #3ab795;
            --accent-color: #f5b434;
            --light-color: #f8f9fa;
            --dark-color: #2c3e50;
            --text-color: #34495e;
            --text-light: #7f8c8d;
            --border-radius: 12px;
            --border-radius-sm: 8px;
            --box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
            --box-shadow-lg: 0 15px 40px rgba(0, 0, 0, 0.12);
            --transition: all 0.3s ease;
            --gradient-primary: linear-gradient(135deg, var(--primary-color), var(--primary-light));
            --gradient-accent: linear-gradient(135deg, var(--accent-color), #ff9d00);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif;
            background-color: #f8fafc;
            color: var(--text-color);
            line-height: 1.6;
            overflow-x: hidden;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Header */
        .header {
            background: white;
            box-shadow: 0 2px 20px rgba(0, 0, 0, 0.08);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .nav-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 80px;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 700;
            font-size: 1.5rem;
            color: var(--primary-color);
        }

        .logo-icon {
            width: 40px;
            height: 40px;
            background: var(--gradient-primary);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
        }

        /* Hero Section */
        .hero {
            background: linear-gradient(135deg, rgba(26, 94, 99, 0.05) 0%, rgba(45, 147, 108, 0.05) 100%);
            padding: 80px 0 60px;
            text-align: center;
        }

        .hero h1 {
            font-size: 2.5rem;
            margin-bottom: 1rem;
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero p {
            font-size: 1.2rem;
            color: var(--text-light);
            max-width: 700px;
            margin: 0 auto 2rem;
        }

        /* Section Styling */
        .section {
            padding: 80px 0;
        }

        .section-title {
            text-align: center;
            margin-bottom: 3rem;
        }

        .section-title h2 {
            font-size: 2.2rem;
            margin-bottom: 1rem;
            color: var(--dark-color);
        }

        .section-title p {
            font-size: 1.1rem;
            color: var(--text-light);
            max-width: 600px;
            margin: 0 auto;
        }

        /* Prayer Times Widget */
        .prayer-widget {
            background: white;
            border-radius: var(--border-radius);
            box-shadow: var(--box-shadow);
            overflow: hidden;
            margin-bottom: 2rem;
        }

        .prayer-header {
            background: var(--gradient-primary);
            color: white;
            padding: 1.5rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .location-info h3 {
            color: white;
            margin-bottom: 0.5rem;
        }

        .location-info p {
            color: rgba(255, 255, 255, 0.8);
            font-size: 0.9rem;
        }

        .date-info {
            text-align: right;
        }

        .date-info .hijri-date {
            font-size: 0.9rem;
            color: rgba(255, 255, 255, 0.8);
        }

        .prayer-controls {
            background: #f8f9fa;
            padding: 1.5rem 2rem;
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
            align-items: center;
        }

        .location-selector {
            display: flex;
            gap: 0.5rem;
            flex: 1;
            min-width: 250px;
        }

        .location-input {
            flex: 1;
            padding: 0.8rem 1rem;
            border: 1px solid #dee2e6;
            border-radius: var(--border-radius-sm);
            font-size: 1rem;
        }

        .method-selector {
            display: flex;
            gap: 0.5rem;
            align-items: center;
        }

        .method-select {
            padding: 0.8rem 1rem;
            border: 1px solid #dee2e6;
            border-radius: var(--border-radius-sm);
            font-size: 1rem;
            background: white;
        }

        .btn {
            display: inline-block;
            padding: 0.8rem 1.5rem;
            background: var(--gradient-primary);
            color: white;
            border-radius: var(--border-radius-sm);
            text-decoration: none;
            font-weight: 600;
            transition: var(--transition);
            border: none;
            cursor: pointer;
            font-size: 1rem;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--box-shadow);
        }

        .btn-outline {
            background: transparent;
            border: 2px solid var(--primary-color);
            color: var(--primary-color);
        }

        .btn-outline:hover {
            background: var(--primary-color);
            color: white;
        }

        .prayer-times-container {
            padding: 2rem;
        }

        .prayer-times-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
        }

        .prayer-time-card {
            background: #f8f9fa;
            border-radius: var(--border-radius);
            padding: 1.5rem;
            text-align: center;
            transition: var(--transition);
            position: relative;
            overflow: hidden;
        }

        .prayer-time-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--box-shadow);
        }

        .prayer-time-card.active {
            background: var(--gradient-primary);
            color: white;
        }

        .prayer-time-card.next {
            background: var(--gradient-accent);
            color: white;
        }

        .prayer-icon {
            font-size: 2rem;
            margin-bottom: 0.5rem;
        }

        .prayer-name {
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .prayer-time {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .prayer-remaining {
            font-size: 0.8rem;
            opacity: 0.8;
        }

        /* Next Prayer Section */
        .next-prayer {
            background: var(--gradient-primary);
            color: white;
            border-radius: var(--border-radius);
            padding: 2rem;
            text-align: center;
            margin-bottom: 2rem;
            box-shadow: var(--box-shadow);
        }

        .next-prayer h3 {
            color: white;
            margin-bottom: 1rem;
        }

        .countdown {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 1rem 0;
            font-family: 'Courier New', monospace;
        }

        .next-prayer-info {
            display: flex;
            justify-content: center;
            gap: 2rem;
            flex-wrap: wrap;
            margin-top: 1.5rem;
        }

        .next-prayer-item {
            text-align: center;
        }

        .next-prayer-label {
            font-size: 0.9rem;
            opacity: 0.8;
            margin-bottom: 0.5rem;
        }

        .next-prayer-value {
            font-size: 1.2rem;
            font-weight: 600;
        }

        /* Monthly Prayer Times */
        .monthly-prayer {
            background: white;
            border-radius: var(--border-radius);
            box-shadow: var(--box-shadow);
            padding: 2rem;
            margin-bottom: 2rem;
        }

        .monthly-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .month-nav {
            display: flex;
            gap: 0.5rem;
            align-items: center;
        }

        .month-nav-btn {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #f8f9fa;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
        }

        .month-nav-btn:hover {
            background: var(--primary-color);
            color: white;
        }

        .prayer-table {
            width: 100%;
            border-collapse: collapse;
        }

        .prayer-table th {
            background: #f8f9fa;
            padding: 1rem;
            text-align: center;
            font-weight: 600;
            border-bottom: 2px solid #dee2e6;
        }

        .prayer-table td {
            padding: 1rem;
            text-align: center;
            border-bottom: 1px solid #dee2e6;
        }

        .prayer-table tr:hover {
            background: #f8f9fa;
        }

        .prayer-table .today {
            background: rgba(26, 94, 99, 0.05);
            font-weight: 600;
        }

        /* Qibla Finder */
        .qibla-finder {
            background: white;
            border-radius: var(--border-radius);
            box-shadow: var(--box-shadow);
            padding: 2rem;
            text-align: center;
        }

        .qibla-compass {
            width: 200px;
            height: 200px;
            margin: 0 auto 2rem;
            position: relative;
        }

        .compass-circle {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            background: #f8f9fa;
            border: 2px solid var(--primary-color);
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .compass-needle {
            position: absolute;
            width: 4px;
            height: 80px;
            background: var(--accent-color);
            top: 10px;
            left: 50%;
            transform-origin: bottom center;
            transform: translateX(-50%) rotate(0deg);
            transition: transform 1s ease;
        }

        .compass-needle::after {
            content: '';
            position: absolute;
            width: 0;
            height: 0;
            border-left: 8px solid transparent;
            border-right: 8px solid transparent;
            border-top: 12px solid var(--accent-color);
            top: -12px;
            left: 50%;
            transform: translateX(-50%);
        }

        .compass-direction {
            position: absolute;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .direction-n { top: 5px; left: 50%; transform: translateX(-50%); }
        .direction-e { top: 50%; right: 5px; transform: translateY(-50%); }
        .direction-s { bottom: 5px; left: 50%; transform: translateX(-50%); }
        .direction-w { top: 50%; left: 5px; transform: translateY(-50%); }

        .qibla-info {
            margin-top: 1.5rem;
        }

        .qibla-distance {
            font-size: 1.2rem;
            font-weight: 600;
            color: var(--primary-color);
            margin-bottom: 0.5rem;
        }

        /* Loading Animation */
        .loading {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid rgba(255,255,255,.3);
            border-radius: 50%;
            border-top-color: #fff;
            animation: spin 1s ease-in-out infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* Footer */
        .footer {
            background: var(--dark-color);
            color: white;
            padding: 60px 0 30px;
            text-align: center;
        }

        .footer p {
            color: #bdc3c7;
            margin-top: 2rem;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .hero h1 {
                font-size: 2rem;
            }
            
            .section-title h2 {
                font-size: 1.8rem;
            }
            
            .prayer-header, .prayer-controls {
                flex-direction: column;
                align-items: flex-start;
            }
            
            .date-info {
                text-align: left;
            }
            
            .prayer-times-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            
            .prayer-table {
                font-size: 0.9rem;
            }
            
            .prayer-table th, .prayer-table td {
                padding: 0.5rem;
            }
        }

        @media (max-width: 480px) {
            .prayer-times-grid {
                grid-template-columns: 1fr;
            }
            
            .prayer-table {
                font-size: 0.8rem;
            }
        }

        /* Animations */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .fade-in {
            animation: fadeIn 0.5s ease forwards;
        }

        .pulse {
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header class="header">
        <div class="container">
            <div class="nav-container">
                <a href="/" class="logo">
                    <div class="logo-icon">IH</div>
