            <button class="btn" id="detect-location-btn">Detect My Location</button>
        </div>
    </section>

    <!-- Prayer Times Section -->
    <section class="section">
        <div class="container">
            <div class="section-title">
                <h2>Today's Prayer Times</h2>
                <p>Accurate prayer times calculated specifically for your location</p>
            </div>

            <!-- Next Prayer Info -->
            <div class="next-prayer">
                <h3>Next Prayer</h3>
                <div class="countdown" id="countdown">--:--:--</div>
                <div class="next-prayer-info">
                    <div class="next-prayer-item">
                        <div class="next-prayer-label">Prayer</div>
                        <div class="next-prayer-value" id="next-prayer-name">Loading...</div>
                    </div>
                    <div class="next-prayer-item">
                        <div class="next-prayer-label">Time</div>
                        <div class="next-prayer-value" id="next-prayer-time">--:--</div>
                    </div>
                    <div class="next-prayer-item">
                        <div class="next-prayer-label">Location</div>
                        <div class="next-prayer-value" id="next-prayer-location">--</div>
                    </div>
                </div>
            </div>

            <!-- Prayer Times Widget -->
            <div class="prayer-widget">
                <div class="prayer-header">
                    <div class="location-info">
                        <h3 id="location-name">Loading location...</h3>
                        <p id="location-details">Detecting your location</p>
                    </div>
