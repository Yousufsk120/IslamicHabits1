            </div>

            <!-- Monthly Prayer Times -->
            <div class="monthly-prayer">
                <div class="monthly-header">
                    <h3>Monthly Prayer Times</h3>
                    <div class="month-nav">
                        <button class="month-nav-btn" id="prev-month">←</button>
                        <span id="current-month">June 2023</span>
                        <button class="month-nav-btn" id="next-month">→</button>
                    </div>
                </div>
                <div class="table-container">
                    <table class="prayer-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Fajr</th>
                                <th>Sunrise</th>
                                <th>Dhuhr</th>
                                <th>Asr</th>
                                <th>Maghrib</th>
                                <th>Isha</th>
                            </tr>
                        </thead>
                        <tbody id="monthly-prayer-times">
                            <!-- Monthly prayer times will be loaded here -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Qibla Finder -->
            <div class="qibla-finder">
                <h3>Qibla Direction</h3>
                <div class="qibla-compass">
                    <div class="compass-circle">
                        <div class="compass-needle" id="compass-needle"></div>
                        <div class="compass-direction direction-n">N</div>
                        <div class="compass-direction direction-e">E</div>
                        <div class="compass-direction direction-s">S</div>
                        <div class="compass-direction direction-w">W</div>
                    </div>
                </div>
                <div class="qibla-info">
                    <div class="qibla-distance" id="qibla-distance">Calculating...</div>
                    <p>Direction to Kaaba in Mecca from your location</p>
                    <button class="btn btn-outline" id="find-qibla">Find Qibla</button>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="logo" style="justify-content: center; margin-bottom: 2rem;">
                <div class="logo-icon">IH</div>
                Islamic Habits
            </div>
            <p>&copy; 2023 Islamic Habits. All rights reserved.</p>
        </div>
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Elements
            const locationName = document.getElementById('location-name');
            const locationDetails = document.getElementById('location-details');
            const gregorianDate = document.getElementById('gregorian-date');
            const hijriDate = document.getElementById('hijri-date');
            const locationInput = document.getElementById('location-input');
            const searchLocationBtn = document.getElementById('search-location');
            const calculationMethod = document.getElementById('calculation-method');
            const prayerTimesGrid = document.getElementById('prayer-times-grid');
            const countdown = document.getElementById('countdown');
            const nextPrayerName = document.getElementById('next-prayer-name');
            const nextPrayerTime = document.getElementById('next-prayer-time');
            const nextPrayerLocation = document.getElementById('next-prayer-location');
            const detectLocationBtn = document.getElementById('detect-location-btn');
            const monthlyPrayerTimes = document.getElementById('monthly-prayer-times');
            const currentMonth = document.getElementById('current-month');
            const prevMonthBtn = document.getElementById('prev-month');
            const nextMonthBtn = document.getElementById('next-month');
            const compassNeedle = document.getElementById('compass-needle');
            const qiblaDistance = document.getElementById('qibla-distance');
            const findQiblaBtn = document.getElementById('find-qibla');

            // Current location and prayer times
            let currentLocation = { latitude: null, longitude: null, city: 'Mecca', country: 'Saudi Arabia' };
            let currentPrayerTimes = {};
            let nextPrayer = null;
            let countdownTimer = null;
            let currentDate = new Date();
            let currentMonthView = new Date();

            // Prayer names and icons
            const prayers = [
                { name: 'Fajr', icon: '🌅', time: '' },
                { name: 'Sunrise', icon: '☀️', time: '' },
                { name: 'Dhuhr', icon: '🕌', time: '' },
                { name: 'Asr', icon: '📿', time: '' },
                { name: 'Maghrib', icon: '🌇', time: '' },
                { name: 'Isha', icon: '🌙', time: '' }
            ];

            // Initialize the app
            function initApp() {
                updateDateDisplay();
                setupEventListeners();
                getCurrentLocation();
                updateMonthlyPrayerTimes();
            }

            // Update date display
            function updateDateDisplay() {
                const now = new Date();
                const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
                gregorianDate.textContent = now.toLocaleDateString('en-US', options);
                
                // For demo purposes, we'll use a static Hijri date
                // In a real app, you would calculate this properly
                hijriDate.textContent = '14 Dhul Hijjah 1444 AH';
            }

            // Set up event listeners
            function setupEventListeners() {
                searchLocationBtn.addEventListener('click', searchLocation);
                locationInput.addEventListener('keypress', (e) => {
                    if (e.key === 'Enter') searchLocation();
                });
                calculationMethod.addEventListener('change', fetchPrayerTimes);
                detectLocationBtn.addEventListener('click', getCurrentLocation);
                prevMonthBtn.addEventListener('click', () => changeMonth(-1));
                nextMonthBtn.addEventListener('click', () => changeMonth(1));
                findQiblaBtn.addEventListener('click', findQiblaDirection);
            }

            // Get current location
            function getCurrentLocation() {
                detectLocationBtn.innerHTML = '<div class="loading"></div> Detecting...';
                
                if (navigator.geolocation) {
                    navigator.geolocation.getCurrentPosition(
                        position => {
                            currentLocation.latitude = position.coords.latitude;
                            currentLocation.longitude = position.coords.longitude;
                            reverseGeocode(position.coords.latitude, position.coords.longitude);
                            fetchPrayerTimes();
                            detectLocationBtn.textContent = 'Detect My Location';
                        },
                        error => {
                            console.error('Geolocation error:', error);
                            // Default to Mecca if location access is denied
                            currentLocation = { latitude: 21.4225, longitude: 39.8262, city: 'Mecca', country: 'Saudi Arabia' };
                            updateLocationDisplay();
                            fetchPrayerTimes();
                            detectLocationBtn.textContent = 'Detect My Location';
                        }
                    );
                } else {
                    alert('Geolocation is not supported by this browser.');
                    detectLocationBtn.textContent = 'Detect My Location';
                }
            }

            // Search location by city name
            function searchLocation() {
                const location = locationInput.value.trim();
                if (location) {
                    searchLocationBtn.innerHTML = '<div class="loading"></div> Searching...';
                    
                    // In a real app, you would use a geocoding API
                    // For demo, we'll simulate with a timeout
                    setTimeout(() => {
                        // Mock response for demo
                        if (location.toLowerCase().includes('makkah') || location.toLowerCase().includes('mecca')) {
                            currentLocation = { latitude: 21.4225, longitude: 39.8262, city: 'Mecca', country: 'Saudi Arabia' };
                        } else if (location.toLowerCase().includes('madina') || location.toLowerCase().includes('medina')) {
                            currentLocation = { latitude: 24.5247, longitude: 39.5692, city: 'Medina', country: 'Saudi Arabia' };
                        } else if (location.toLowerCase().includes('dubai')) {
                            currentLocation = { latitude: 25.2048, longitude: 55.2708, city: 'Dubai', country: 'UAE' };
                        } else if (location.toLowerCase().includes('london')) {
                            currentLocation = { latitude: 51.5074, longitude: -0.1278, city: 'London', country: 'UK' };
                        } else {
                            currentLocation = { latitude: 40.7128, longitude: -74.0060, city: location, country: 'Unknown' };
                        }
                        
                        updateLocationDisplay();
                        fetchPrayerTimes();
                        searchLocationBtn.textContent = 'Search';
                    }, 1000);
                }
            }

            // Reverse geocode coordinates to get location name
            function reverseGeocode(latitude, longitude) {
                // In a real app, you would use a reverse geocoding API
                // For demo, we'll use a mock service with timeout
                setTimeout(() => {
                    // Mock response based on coordinates
                    if (latitude > 20 && latitude < 25 && longitude > 39 && longitude < 41) {
                        currentLocation.city = 'Mecca';
                        currentLocation.country = 'Saudi Arabia';
                    } else if (latitude > 24 && latitude < 26 && longitude > 39 && longitude < 40) {
                        currentLocation.city = 'Medina';
                        currentLocation.country = 'Saudi Arabia';
                    } else if (latitude > 51 && latitude < 52 && longitude > -1 && longitude < 0) {
                        currentLocation.city = 'London';
                        currentLocation.country = 'UK';
                    } else if (latitude > 40 && latitude < 41 && longitude > -75 && longitude < -73) {
                        currentLocation.city = 'New York';
                        currentLocation.country = 'USA';
                    } else {
                        currentLocation.city = 'Your Location';
                        currentLocation.country = 'Detected';
                    }
                    
                    updateLocationDisplay();
                }, 500);
            }

            // Update location display
            function updateLocationDisplay() {
                locationName.textContent = currentLocation.city;
                locationDetails.textContent = `${currentLocation.country} | Lat: ${currentLocation.latitude?.toFixed(4) || '--'}, Lon: ${currentLocation.longitude?.toFixed(4) || '--'}`;
                nextPrayerLocation.textContent = `${currentLocation.city}, ${currentLocation.country}`;
            }

            // Fetch prayer times from API
            function fetchPrayerTimes() {
                if (!currentLocation.latitude || !currentLocation.longitude) return;
                
                const method = calculationMethod.value;
                const date = new Date();
                const dateString = `${date.getDate()}-${date.getMonth() + 1}-${date.getFullYear()}`;
                
                // Show loading state
                prayerTimesGrid.innerHTML = '<div style="grid-column: 1 / -1; text-align: center; padding: 2rem;">Loading prayer times...</div>';
                
                // In a real app, you would use the Aladhan API or similar
                // For demo, we'll simulate with mock data
                setTimeout(() => {
                    // Generate mock prayer times based on location and method
                    const baseTimes = {
                        Fajr: '05:30',
                        Sunrise: '06:45',
                        Dhuhr: '12:30',
                        Asr: '15:45',
                        Maghrib: '18:20',
                        Isha: '19:45'
                    };
                    
                    // Adjust times slightly based on location and method for realism
                    const timeVariation = (currentLocation.longitude / 10) % 60;
                    Object.keys(baseTimes).forEach(prayer => {
                        const time = baseTimes[prayer];
                        const [hours, minutes] = time.split(':').map(Number);
                        const newMinutes = (minutes + timeVariation) % 60;
                        const newHours = hours + Math.floor((minutes + timeVariation) / 60);
                        currentPrayerTimes[prayer] = `${String(newHours).padStart(2, '0')}:${String(newMinutes).padStart(2, '0')}`;
                    });
                    
                    displayPrayerTimes();
                    calculateNextPrayer();
                }, 800);
            }

            // Display prayer times
            function displayPrayerTimes() {
                prayerTimesGrid.innerHTML = '';
                
                prayers.forEach(prayer => {
                    if (currentPrayerTimes[prayer.name]) {
                        const prayerTime = currentPrayerTimes[prayer.name];
                        const prayerCard = document.createElement('div');
                        prayerCard.className = 'prayer-time-card';
                        
                        // Check if this is the current or next prayer
                        if (nextPrayer && nextPrayer.name === prayer.name) {
                            prayerCard.classList.add('next');
                        }
                        
                        prayerCard.innerHTML = `
                            <div class="prayer-icon">${prayer.icon}</div>
                            <div class="prayer-name">${prayer.name}</div>
                            <div class="prayer-time">${prayerTime}</div>
                            ${nextPrayer && nextPrayer.name === prayer.name ? 
                                `<div class="prayer-remaining" id="remaining-${prayer.name}">Next prayer</div>` : 
                                ''}
                        `;
                        
                        prayerTimesGrid.appendChild(prayerCard);
                    }
                });
            }

            // Calculate next prayer and start countdown
            function calculateNextPrayer() {
                if (countdownTimer) {
                    clearInterval(countdownTimer);
                }
                
                const now = new Date();
                const currentTime = now.getHours() * 60 + now.getMinutes();
                
                // Convert prayer times to minutes since midnight
                const prayerTimesInMinutes = {};
                Object.keys(currentPrayerTimes).forEach(prayer => {
                    if (currentPrayerTimes[prayer]) {
                        const timeParts = currentPrayerTimes[prayer].split(':');
                        prayerTimesInMinutes[prayer] = parseInt(timeParts[0]) * 60 + parseInt(timeParts[1]);
                    }
                });
                
                // Find next prayer
                let nextPrayerTime = null;
                let nextPrayerName = null;
                
                for (const prayer of Object.keys(prayerTimesInMinutes)) {
                    if (prayerTimesInMinutes[prayer] > currentTime) {
                        nextPrayerName = prayer;
                        nextPrayerTime = prayerTimesInMinutes[prayer];
                        break;
                    }
                }
                
                // If no prayer found for today, use first prayer of next day
                if (!nextPrayerName) {
                    nextPrayerName = 'Fajr';
                    nextPrayerTime = prayerTimesInMinutes['Fajr'] + 24 * 60; // Add 24 hours
                }
                
                nextPrayer = { name: nextPrayerName, time: nextPrayerTime };
                
                // Update display
                nextPrayerNameEl.textContent = nextPrayerName;
                nextPrayerTimeEl.textContent = currentPrayerTimes[nextPrayerName];
                
                // Start countdown
                updateCountdown();
                countdownTimer = setInterval(updateCountdown, 1000);
            }

            // Update countdown display
            function updateCountdown() {
                if (!nextPrayer) return;
                
                const now = new Date();
                const currentTimeInMinutes = now.getHours() * 60 + now.getMinutes() + now.getSeconds() / 60;
                
                let timeDiff = nextPrayer.time - currentTimeInMinutes;
                
                // Handle case where next prayer is tomorrow
                if (timeDiff < 0) {
                    timeDiff += 24 * 60;
                }
                
                const hours = Math.floor(timeDiff / 60);
                const minutes = Math.floor(timeDiff % 60);
                const seconds = Math.floor((timeDiff * 60) % 60);
                
                countdown.textContent = `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
            }

            // Update monthly prayer times
            function updateMonthlyPrayerTimes() {
                const monthNames = ["January", "February", "March", "April", "May", "June",
                    "July", "August", "September", "October", "November", "December"];
                
                currentMonth.textContent = `${monthNames[currentMonthView.getMonth()]} ${currentMonthView.getFullYear()}`;
                
                // Generate mock monthly prayer times for demo
                let html = '';
                const daysInMonth = new Date(currentMonthView.getFullYear(), currentMonthView.getMonth() + 1, 0).getDate();
                const today = new Date();
                
                for (let day = 1; day <= daysInMonth; day++) {
                    const isToday = today.getDate() === day && 
                                   today.getMonth() === currentMonthView.getMonth() && 
                                   today.getFullYear() === currentMonthView.getFullYear();
                    
                    // Generate slightly varying prayer times for each day
                    const fajrTime = `05:${String(30 + (day % 10)).padStart(2, '0')}`;
                    const sunriseTime = `06:${String(45 + (day % 10)).padStart(2, '0')}`;
                    const dhuhrTime = `12:${String(30 + (day % 10)).padStart(2, '0')}`;
                    const asrTime = `15:${String(45 + (day % 10)).padStart(2, '0')}`;
                    const maghribTime = `18:${String(20 + (day % 10)).padStart(2, '0')}`;
                    const ishaTime = `19:${String(45 + (day % 10)).padStart(2, '0')}`;
                    
                    html += `
                        <tr class="${isToday ? 'today' : ''}">
                            <td>${day}</td>
                            <td>${fajrTime}</td>
                            <td>${sunriseTime}</td>
                            <td>${dhuhrTime}</td>
                            <td>${asrTime}</td>
                            <td>${maghribTime}</td>
                            <td>${ishaTime}</td>
                        </tr>
                    `;
                }
                
                monthlyPrayerTimes.innerHTML = html;
            }

            // Change month for monthly view
            function changeMonth(direction) {
                currentMonthView.setMonth(currentMonthView.getMonth() + direction);
                updateMonthlyPrayerTimes();
            }

            // Find Qibla direction
            function findQiblaDirection() {
                if (!currentLocation.latitude || !currentLocation.longitude) {
                    alert('Please enable location services to find Qibla direction');
                    return;
                }
                
                findQiblaBtn.innerHTML = '<div class="loading"></div> Finding...';
                
                // In a real app, you would calculate the Qibla direction based on coordinates
                // For demo, we'll simulate with a random direction
                setTimeout(() => {
                    const randomDirection = Math.random() * 360;
                    compassNeedle.style.transform = `translateX(-50%) rotate(${randomDirection}deg)`;
                    
                    // Calculate approximate distance to Mecca
                    const meccaLat = 21.4225;
                    const meccaLon = 39.8262;
                    const distance = calculateDistance(
                        currentLocation.latitude, 
                        currentLocation.longitude, 
                        meccaLat, 
                        meccaLon
                    );
                    
                    qiblaDistance.textContent = `${distance.toFixed(0)} km to Mecca`;
                    findQiblaBtn.textContent = 'Find Qibla';
                }, 1500);
            }

            // Calculate distance between two coordinates (Haversine formula)
            function calculateDistance(lat1, lon1, lat2, lon2) {
                const R = 6371; // Earth's radius in km
                const dLat = (lat2 - lat1) * Math.PI / 180;
                const dLon = (lon2 - lon1) * Math.PI / 180;
                const a = 
                    Math.sin(dLat/2) * Math.sin(dLat/2) +
                    Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                    Math.sin(dLon/2) * Math.sin(dLon/2);
                const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
                return R * c;
            }

            // Fix for missing elements
            const nextPrayerNameEl = document.getElementById('next-prayer-name');
            const nextPrayerTimeEl = document.getElementById('next-prayer-time');

            // Initialize the app
            initApp();
        });
    </script>
